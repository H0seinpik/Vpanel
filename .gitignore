# dependencies
/node_modules
/.pnp
.pnp.js
# Project-local npm cache (used when the global cache is not writable)
/.npm-cache

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# prisma / database
/prisma/*.db
/prisma/*.db-journal

# test coverage
/coverage

# runtime state written by the Windows control scripts (pids, logs)
/.vpanel

# backups — must never be committed or stored publicly
/backups
*.sql.gz
*.dump

# editor
.idea
.vscode/*
!.vscode/extensions.json
