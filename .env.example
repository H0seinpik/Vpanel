# =============================================================================
# VPanel — environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Public origin of the app (used for cookie security + subscription URLs).
#
# Set this to how you actually reach the panel:
#   http://localhost:3000            native mode, this PC only
#   http://192.168.1.50              Docker mode, reached from your LAN
#   https://panel.example.com        behind TLS
#
# It drives the cookie `Secure` flag: an https URL sets it, an http URL does
# not. Getting this wrong is the usual cause of "login works but I am bounced
# back to /login" when accessing over a LAN IP.
APP_URL=http://localhost:3000
APP_NAME=VPanel

# Cookie `Secure` flag: auto | true | false
# `auto` follows APP_URL (recommended). Force `true` only when serving HTTPS.
COOKIE_SECURE=auto

# Port used by native (non-Docker) mode. Docker mode uses HTTP_PORT below.
PORT=3000

# --- Database ----------------------------------------------------------------
# Used by the application at runtime (native mode + CLI commands).
# In Docker mode the containers get DATABASE_URL built from POSTGRES_* below,
# so this value only matters for commands you run on the host.
DATABASE_URL="postgresql://vpanel:vpanel@localhost:5432/vpanel?schema=public&connection_limit=10"

# No DIRECT_URL is needed: the schema talks straight to PostgreSQL rather than
# through a connection pooler. Only add it (and a `directUrl` line in
# prisma/schema.prisma) if you introduce PgBouncer or a hosted proxy.

# --- Docker / docker-compose only --------------------------------------------
# Credentials for the PostgreSQL container created by docker-compose.yml.
# install.bat fills POSTGRES_PASSWORD in automatically with a random value.
POSTGRES_USER=vpanel
POSTGRES_DB=vpanel
POSTGRES_PASSWORD=

# Ports the nginx container publishes.
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. Different values for access & refresh.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-string
# Access token lifetime (seconds) and refresh token lifetime (seconds).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Redis (optional; used for caching, rate-limit + worker locks) -----------
# Leave blank to run in single-node mode (in-memory fallbacks are used).
REDIS_URL=redis://localhost:6379

# --- Bootstrap admin ---------------------------------------------------------
# Created by `npm run db:seed`. Change immediately after first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe_Str0ng_Password!
SEED_ADMIN_USERNAME=admin

# --- Workers -----------------------------------------------------------------
# Enable the in-process scheduler when running the Next.js server (dev only).
ENABLE_INLINE_WORKER=false
# Monitoring/heartbeat interval (seconds).
MONITOR_INTERVAL_SECONDS=60
# Traffic collection interval (seconds).
TRAFFIC_INTERVAL_SECONDS=120
# Worker shared lock TTL (seconds) so multiple replicas don't double-collect.
WORKER_LOCK_TTL_SECONDS=90

# --- Defaults (overridable at runtime via Admin → Settings) ------------------
DEFAULT_TRAFFIC_LIMIT_GB=100
DEFAULT_EXPIRATION_DAYS=30
DEFAULT_SESSION_TIMEOUT_MINUTES=60
DEFAULT_TRAFFIC_WARN_PERCENT=80

# --- Node provider mode ------------------------------------------------------
# `local` = built-in simulation/local provider (safe default, no external calls).
# `agent` = talk to a per-server VPanel agent over HTTPS using an API token.
NODE_PROVIDER=local
# Shared secret the agent uses to authenticate to this panel (agent mode).
AGENT_SHARED_SECRET=

# --- Mail (optional, disabled by default) ------------------------------------
SMTP_URL=
MAIL_FROM="VPanel <no-reply@example.com>"

# --- Telegram (optional, disabled by default) --------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local Xray supervisor ----------------------------------------------------
# When enabled, the panel manages a local Xray instance: it writes config.json
# from the database, restarts Xray when the config changes, and reads real
# per-user traffic from the node's stats API.
#
# Set NODE_PROVIDER=xray as well, otherwise traffic is simulated instead of read.
XRAY_ENABLED=false
XRAY_DIR=C:/xray
XRAY_API_PORT=10085
XRAY_AUTO_SYNC=true
